{
    "name": "componenta/policy",
    "description": "Policy contracts, attributes, and providers for Componenta authorization",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^3.0.0",
        "componenta/di": "^5.0.3",
        "componenta/identity": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2.14"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Policy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Policy\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Policy\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
